{
  "name": "autoqc-studio",
  "productName": "AutoQC Studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ComfyUI + 로컬/클라우드 LLM으로 이미지 생성 → 자동 검수 → 실패 시 재생성까지 이어지는 제작 툴",
  "author": "Junho Song",
  "scripts": {
    "start": "vite build && tsx server/index.ts",
    "dev": "tsx server/index.ts --dev",
